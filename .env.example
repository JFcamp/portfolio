# ============================================================
# Root environment reference. Copy the relevant blocks into
# backend/.env and frontend/.env (each subproject has its own
# .env.example too). NEVER commit real secrets — this is a template.
# ============================================================

# ---- Backend ----
# Embeddings: "local" (sentence-transformers, multilingual, no key — recommended)
#           | "offline" (hashing fallback, no deps) | "openai"
EMBEDDING_PROVIDER=local
LOCAL_EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2

# LLM: "offline" (extractive, no key) | "groq" | "gemini" | "openai"
# Groq and Gemini have free tiers (no credit card). Get a Groq key at
# https://console.groq.com -> API Keys, then set the two lines below.
LLM_PROVIDER=groq
LLM_API_KEY=
# Model per provider:
#   groq:   openai/gpt-oss-20b  (fast, free)  |  openai/gpt-oss-120b (stronger)
#   gemini: gemini-1.5-flash
#   openai: gpt-4o-mini
LLM_MODEL=openai/gpt-oss-20b
EMBEDDING_MODEL=text-embedding-3-small

# Vector store: "faiss" (default, local)
VECTOR_DB=faiss
VECTOR_STORE_PATH=app/rag/store

# RAG tuning
CHUNK_SIZE=800
CHUNK_OVERLAP=120
RETRIEVAL_TOP_K=10
RELEVANCE_THRESHOLD=0.28          # hashing fallback
LOCAL_RELEVANCE_THRESHOLD=0.25    # sentence-transformers

# API security
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_QUESTION_LENGTH=1000
RATE_LIMIT=20/minute
LLM_TIMEOUT_SECONDS=30
LOG_LEVEL=INFO

# ---- Frontend ----
VITE_API_URL=http://localhost:8000
