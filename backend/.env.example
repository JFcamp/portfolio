# Copy to backend/.env for local dev. Never commit real secrets.

# ---- Embeddings ----
# EMBEDDING_PROVIDER:
#   "fastembed" — in-process ONNX embeddings, no API/key, no torch, deterministic
#                 (recommended: local and prod match, no rate limits)
#   "gemini"    — Google free embedding API (free-tier rate limits apply)
#   "local"     — sentence-transformers, multilingual, runs locally (needs RAM)
#   "openai"    — OpenAI embeddings (needs key)
#   "offline"   — hashing fallback, no key/network (weakest)
EMBEDDING_PROVIDER=fastembed
FASTEMBED_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# Only needed for gemini/openai providers (Google AI Studio or OpenAI key):
EMBEDDING_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
LOCAL_EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2

# ---- LLM (answer generation) ----
# LLM_PROVIDER: "groq" | "gemini" | "openai" | "offline" (extractive, no key)
LLM_PROVIDER=groq
LLM_API_KEY=
# Model per provider:
#   groq:   openai/gpt-oss-20b (fast, free) | openai/gpt-oss-120b (stronger)
#   gemini: gemini-1.5-flash
#   openai: gpt-4o-mini
LLM_MODEL=openai/gpt-oss-20b
EMBEDDING_MODEL=text-embedding-3-small

# ---- Vector store ----
VECTOR_DB=faiss
VECTOR_STORE_PATH=app/rag/store

# ---- RAG tuning ----
CHUNK_SIZE=800
CHUNK_OVERLAP=120
RETRIEVAL_TOP_K=10
RELEVANCE_THRESHOLD=0.25            # hashing fallback
SEMANTIC_RELEVANCE_THRESHOLD=0.45   # fastembed/local/gemini (hybrid lexical path catches exact terms)

# ---- API / security ----
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_QUESTION_LENGTH=1000
RATE_LIMIT=20/minute
LLM_TIMEOUT_SECONDS=30
LOG_LEVEL=INFO
