# Copy to backend/.env for local dev. Never commit real secrets.

# ---- Embeddings ----
# EMBEDDING_PROVIDER:
#   "gemini"  — Google free embedding API, no RAM cost (recommended for hosting)
#   "local"   — sentence-transformers, multilingual, runs locally (needs RAM)
#   "openai"  — OpenAI embeddings (needs key)
#   "offline" — hashing fallback, no key/network (weakest)
EMBEDDING_PROVIDER=gemini
# Dedicated embeddings key (Google AI Studio for gemini, or OpenAI). If empty,
# falls back to LLM_API_KEY. Get a free Gemini key at aistudio.google.com.
EMBEDDING_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
LOCAL_EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2

# ---- LLM (answer generation) ----
# LLM_PROVIDER: "groq" | "gemini" | "openai" | "offline" (extractive, no key)
LLM_PROVIDER=groq
LLM_API_KEY=
# Model per provider:
#   groq:   openai/gpt-oss-20b (fast, free) | openai/gpt-oss-120b (stronger)
#   gemini: gemini-1.5-flash
#   openai: gpt-4o-mini
LLM_MODEL=openai/gpt-oss-20b
EMBEDDING_MODEL=text-embedding-3-small

# ---- Vector store ----
VECTOR_DB=faiss
VECTOR_STORE_PATH=app/rag/store

# ---- RAG tuning ----
CHUNK_SIZE=800
CHUNK_OVERLAP=120
RETRIEVAL_TOP_K=10
RELEVANCE_THRESHOLD=0.25            # hashing fallback
SEMANTIC_RELEVANCE_THRESHOLD=0.30   # gemini / local / openai (permissive; LLM judges relevance)

# ---- API / security ----
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_QUESTION_LENGTH=1000
RATE_LIMIT=20/minute
LLM_TIMEOUT_SECONDS=30
LOG_LEVEL=INFO
