# Copy to backend/.env for local dev. Never commit real secrets.

# ---- Providers ----
# EMBEDDING_PROVIDER: "local" (sentence-transformers, multilingual, no key) |
#                     "offline" (hashing fallback) | "openai"
EMBEDDING_PROVIDER=local
LOCAL_EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2

# LLM_PROVIDER: "offline" (extractive, no key) | "groq" | "gemini" | "openai"
# Groq and Gemini both have a free tier — get a key and paste it below.
LLM_PROVIDER=offline
LLM_API_KEY=
# Model per provider:
#   groq:   openai/gpt-oss-20b  (fast, free tier)  |  openai/gpt-oss-120b (stronger)
#   gemini: gemini-1.5-flash
#   openai: gpt-4o-mini
LLM_MODEL=openai/gpt-oss-20b
EMBEDDING_MODEL=text-embedding-3-small

# ---- Vector store ----
VECTOR_DB=faiss
VECTOR_STORE_PATH=app/rag/store

# ---- RAG tuning ----
CHUNK_SIZE=800
CHUNK_OVERLAP=120
RETRIEVAL_TOP_K=5
RELEVANCE_THRESHOLD=0.28          # hashing fallback
LOCAL_RELEVANCE_THRESHOLD=0.35    # sentence-transformers

# ---- API / security ----
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_QUESTION_LENGTH=1000
RATE_LIMIT=20/minute
LLM_TIMEOUT_SECONDS=30
LOG_LEVEL=INFO
